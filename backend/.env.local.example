# SeereonOS API — LOCAL DEVELOPMENT (copy to .env.local; it is git-ignored). Load it into your shell, e.g.
#   set -a; . ./.env.local; set +a
# Never use these values anywhere but your own machine. Production template: .env.example.
APP_ENV=development
TZ=Asia/Kolkata
LOG_LEVEL=info

# one database, two roles — created with database/bootstrap.sql (local passwords of your choice)
DATABASE_URL=postgres://seereon_app:seereon_app@localhost:5432/seereonos
# owner: python -m app.db.migrate, python -m app.db.reset, python -m app.devtools.fixtures (never the API)
MIGRATION_DATABASE_URL=postgres://seereon_owner:seereon_owner@localhost:5432/seereonos

# the Vite dev server (frontend/: npm run dev) — links in e-mails and the allowed CORS origin
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# no SMTP locally: e-mails are queued, not sent; read them with python -m app.devtools.mailbox
# (or run a local catcher such as MailHog / Mailpit and set SMTP_URL=smtp://localhost:1025 + EMAIL_DELIVERY=smtp)
EMAIL_DELIVERY=disabled
# MFA_ENCRYPTION_KEY unset: the built-in development key is used (refused in production)

# payments off locally (409 PAYMENTS_NOT_CONFIGURED); Razorpay test keys work too (rzp_test_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# relaxed limits for local testing
RATE_LIMIT_AUTH=100
