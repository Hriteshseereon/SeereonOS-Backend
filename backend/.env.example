# SeereonOS API — PRODUCTION configuration template. Placeholders only: never commit real values (.env is git-ignored).
# Use with backend/deploy/docker-compose.yml (cp ../.env.example deploy/.env) or your orchestrator's secret store.
# The API and the worker REFUSE TO START when a required value is missing or still a placeholder (see README.md).
# Local development: .env.local.example.

# --- runtime ---------------------------------------------------------------------------------------------------------
APP_ENV=production
# business time zone: "today" for every tenant (compose passes it as TZ)
SEEREON_TZ=Asia/Kolkata
LOG_LEVEL=info
WEB_CONCURRENCY=2

# REQUIRED: the public https URL of the web app (links in password-reset, invitation and welcome e-mails)
APP_URL=https://app.example.com
# REQUIRED: the exact origin(s) of the web app that call this API (comma-separated, https, never *)
CORS_ORIGINS=https://app.example.com
# number of trusted reverse proxies / load balancers in front of the API (0 = none: X-Forwarded-For is ignored).
# Set 1 when exactly one proxy (e.g. the load balancer) appends the client address; never when clients reach the API
# directly (they could forge the header and dodge the rate limits).
TRUST_PROXY=0

# --- database: ONE database, roles not databases (database/docs/README.md) -------------------------------------------------
SEEREON_DB=seereonos
# the runtime role seereon_app (API, worker, CLI): DATABASE_URL=postgres://seereon_app:<password>@<host>:5432/seereonos
SEEREON_APP_PASSWORD=CHANGE_ME
# the owner role, used ONLY by the migrate job (MIGRATION_DATABASE_URL=postgres://seereon_owner:<password>@…)
SEEREON_OWNER_PASSWORD=CHANGE_ME
# postgres superuser of the bundled database container (compose only; first start only)
POSTGRES_PASSWORD=CHANGE_ME
# outside compose, set the URLs directly:
# DATABASE_URL=postgres://seereon_app:CHANGE_ME@db.internal:5432/seereonos
# MIGRATION_DATABASE_URL=postgres://seereon_owner:CHANGE_ME@db.internal:5432/seereonos

# --- secrets -----------------------------------------------------------------------------------------------------------
# REQUIRED: seals two-step (TOTP) secrets and queued reset / invitation links at rest (AES-256-GCM).
#   openssl rand -base64 48        rotate: move the old key to MFA_ENCRYPTION_KEY_PREVIOUS (comma-separated)
MFA_ENCRYPTION_KEY=CHANGE_ME
MFA_ENCRYPTION_KEY_PREVIOUS=

# --- e-mail (REQUIRED in production: SMTP_URL, or EMAIL_DELIVERY=disabled explicitly) ---------------------------------
# smtps://user:password@smtp.example.com:465  or  smtp://user:password@smtp.example.com:587 (STARTTLS)
SMTP_URL=smtps://CHANGE_ME:CHANGE_ME@smtp.example.com:465
MAIL_FROM="SeereonOS <no-reply@example.com>"
# EMAIL_DELIVERY=disabled   # only if you really run without e-mail: no reset links, invitations or notifications
EMAIL_MAX_ATTEMPTS=8

# shown on the billing page (whom to contact about plans, e.g. while online payments are off)
SUPPORT_EMAIL=
# Swagger UI (/api/docs) + /api/v1/openapi.json: default false when APP_ENV=production, true in development
# API_DOCS_ENABLED=false

# --- payments: Razorpay (leave all three empty to keep payments off: 409 PAYMENTS_NOT_CONFIGURED) ----------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED when the keys are set: Dashboard → Webhooks → secret; URL https://<api>/api/v1/billing/webhooks/razorpay,
# events payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# --- monitoring --------------------------------------------------------------------------------------------------------
# optional error monitoring (no personal data, secrets scrubbed)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# /metrics (Prometheus) is served only when set: Authorization: Bearer <METRICS_TOKEN> (>= 24 chars)
METRICS_TOKEN=
# /readyz warns when the newest worker heartbeat is older than this
WORKER_STALE_SECONDS=180

# --- security knobs (defaults are fine) --------------------------------------------------------------------------------
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=30
RATE_LIMIT_AUTH=10
RATE_LIMIT_GLOBAL=600
SECURITY_EVENTS_RETENTION_DAYS=400

# --- worker schedule (seconds) -----------------------------------------------------------------------------------------
EMAIL_INTERVAL_SECONDS=5
JOBS_INTERVAL_SECONDS=300
CLEANUP_INTERVAL_SECONDS=3600

# --- performance (backend/PERFORMANCE.md "Tuning knobs"; defaults are fine) ---------------------------------------------
PG_POOL_MAX=20
STATEMENT_TIMEOUT_MS=30000
TENANT_CACHE_MAX=50
TENANT_CACHE_MAX_MB=512
REQUEST_THREADS=4
WRITE_THREADS=2
